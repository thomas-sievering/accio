{
  "name": "accio",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @accio/protocol -w @accio/server -w @accio/web -w @accio/desktop",
    "start": "npm run build && npm run start -w @accio/desktop",
    "server": "npm run build -w @accio/protocol -w @accio/server -w @accio/web && node apps/server/dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p apps/web",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "esbuild@0.28.2": true
  }
}
