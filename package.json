{
  "name": "accio",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "tsx apps/worker/src/cli/main.ts",
    "build": "pnpm -r build",
    "start": "pnpm build && pnpm --filter @accio/desktop start",
    "try": "pnpm build && node scripts/try.mjs",
    "worker": "pnpm --filter \"@accio/worker...\" --filter @accio/web build && node apps/worker/dist/main.js",
    "hub": "pnpm --filter \"@accio/hub...\" build && node apps/hub/dist/main.js",
    "hub:pair": "node apps/hub/dist/main.js --pair",
    "dev:hub": "node scripts/dev-hub.mjs",
    "test": "pnpm test:verification && vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:chat": "pnpm build && playwright test --project chat",
    "test:secrets": "pnpm build && playwright test --project secrets",
    "test:limits": "pnpm build && playwright test --project limits",
    "verify": "pnpm build && node .agents/skills/3-verify/scripts/verify.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "test:verification": "node --test scripts/verify-ui.test.mjs",
    "verify:doctor": "node .agents/skills/3-verify/scripts/verify.mjs doctor",
    "verify:link-hub": "pnpm build && node .agents/skills/3-verify/scripts/verify.mjs .agents/skills/3-verify/scripts/link-hub.mjs",
    "verify:real": "pnpm build && node .agents/skills/3-verify/scripts/verify.mjs .agents/skills/3-verify/scripts/real-turn.mjs",
    "typecheck": "tsc -b && tsc -p apps/web",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
