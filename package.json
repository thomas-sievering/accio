{
  "name": "accio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "start": "pnpm build && pnpm --filter @accio/desktop start",
    "server": "pnpm --filter \"@accio/server...\" --filter @accio/web build && node apps/server/dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p apps/web",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
